{
  "name": "cloud-shell-mcp-server",
  "version": "1.0.0",
  "description": "Remote MCP server that lets Claude drive your Google Cloud Shell environment (start it, run shell/gcloud commands over SSH) via a claude.ai custom connector secured with Google OAuth.",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google-cloud/firestore": "^8.6.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.18.1",
    "express": "^5.2.1",
    "jose": "^6.1.3",
    "ssh2": "^1.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.10.0",
    "@types/ssh2": "^1.15.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  }
}
